+        ptr[1] = (void *)adapter->physaddr;
+
 	return 0;
 }
+
+int igb_setup_flex_filter(struct igb_adapter *adapter, unsigned int queue_id,
+			  unsigned int filter_id, unsigned int filter_len,
+			  u_int8_t *filter, u_int8_t *mask)
+{
+	struct e1000_hw *hw;
+	u32 i = 0, j, k;
+	u32 fhft, wufc, fhft_reg;
+	u_int8_t *filter_buf = filter;
+
+	if (adapter == NULL)
+		return -ENXIO;
+
+	if (filter_id > 7)
+		return -EINVAL;
+
+	if (queue_id > 1)
+		return -EINVAL;
+
+	if (filter_len > 128)
+		return -EINVAL;
+
+	if (filter_len % 8) {
+		unsigned int aligned_filter_len = ((filter_len + (8 - 1)) / 8) * 8;
+
+		printk(KERN_WARNING "filter_len(%d) should be a 8 byte aligned value\n",
+					filter_len);
+
+		filter_buf = kmalloc(1, aligned_filter_len);
+		if (!filter_buf)
+			return -ENOMEM;
+
+		memcpy((void*)filter_buf, (void*)filter, (size_t)filter_len);
+		filter_len = aligned_filter_len;
+	}
+
+	hw = &adapter->hw;
+
+	/* i210: flex filters 4-7 live in the separate FHFT_EXT table, not FHFT */
+	fhft_reg = filter_id < 4 ? E1000_FHFT(filter_id)
+				 : E1000_FHFT_EXT(filter_id - 4);
+
+	while (i < filter_len) {
+		for (j = 0; j < 8; j += 4) {
+			fhft = 0;
+			for (k = 0; k < 4; k++)
+				fhft |= ((u32)(filter_buf[i + j + k])) << (k * 8);
+			E1000_WRITE_REG_ARRAY(hw, fhft_reg,
+					(i/2) + (j/4), fhft);
+		}
+		E1000_WRITE_REG_ARRAY(hw, fhft_reg,
+				(i/2) + 2, mask[i/8]);
+		i += 8;
+	}
+
+	E1000_WRITE_REG_ARRAY(hw, fhft_reg,
+			63, (1 << 24) | (queue_id << 8) | filter_len);
+
+	E1000_WRITE_REG(hw, E1000_WUC, 0x21);
+
+	wufc = E1000_READ_REG(hw, E1000_WUFC);
+	wufc |= (E1000_WUFC_FLX0 << filter_id) | E1000_WUFC_FLEX_HQ;
+	E1000_WRITE_REG(hw, E1000_WUFC, wufc);
+
+	if (filter_buf && (filter_buf != filter))
+		kfree(filter_buf);
+
+	return 0;
+}
+
+int igb_clear_flex_filter(struct igb_adapter *adapter, unsigned int filter_id)
+{
+	struct e1000_hw *hw;
+	u32 wufc;
+
+	if (adapter == NULL)
+		return -EINVAL;
+
+	if (filter_id > 7)
+		return -EINVAL;
+
+	hw = &adapter->hw;
+
+	wufc = E1000_READ_REG(hw, E1000_WUFC);
+	wufc &= ~(E1000_WUFC_FLX0 << filter_id);
+	E1000_WRITE_REG(hw, E1000_WUFC, wufc);
+
+	return 0;
+}
+
