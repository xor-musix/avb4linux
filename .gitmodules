[submodule "jdksavdecc-c"]
	path = jdksavdecc-c
	url = https://github.com/jdkoftinoff/jdksavdecc-c
	ignore = dirty
[submodule "kernel-module/igb_avb"]
	path = kernel-module/igb_avb
	url = https://github.com/Avnu/igb_avb.git
[submodule "daemons/gptp"]
	path = daemons/gptp
	url = https://github.com/Avnu/gptp.git
[submodule "daemons/OpenAvnu"]
	path = daemons/OpenAvnu
	url = https://github.com/Avnu/OpenAvnu.git
[submodule "utils/tcpdump"]
	path = utils/tcpdump
	url = https://github.com/the-tcpdump-group/tcpdump.git
	ignore = dirty
[submodule "utils/libpcap"]
	path = utils/libpcap
	url = https://github.com/the-tcpdump-group/libpcap.git
	ignore = dirty
